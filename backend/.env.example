# ---------------------------------------------------------------------------
# Salon & Spa OS - backend environment
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is tracked and
# must contain placeholders only - never a real credential.
#
# Required in production (the server REFUSES to boot without them when
# NODE_ENV=production): JWT_SECRET, MONGO_URI, CORS_ORIGIN.
# ---------------------------------------------------------------------------

# Server
PORT=5005
# DISABLE_CRON=1               # optional: run the API with the background
#                              # timers parked (no-show sweep, offer expiry,
#                              # payment-order reaper). IGNORED and warned about
#                              # when NODE_ENV=production.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Atlas SRV or a local mongod. Keep the mongodb+srv:// form: the SRV retry in
# app.js exists to survive networks whose resolver refuses SRV queries.
MONGO_URI=mongodb://localhost:27017/salon_spa_os
# MONGO_DB=salon_spa_os            # optional: override the database name
# DNS_SERVERS=8.8.8.8,1.1.1.1      # optional: pin Node's resolver for Atlas SRV

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Sign and verify every owner JWT. A shared or
# guessable value lets anyone mint a valid owner token. Use >= 32 random bytes.
JWT_SECRET=replace_with_32_plus_random_bytes

# REQUIRED IN PRODUCTION. Comma-separated allowlist of browser origins allowed
# to call this API, e.g. https://app.example.com,https://www.example.com.
# When unset the API accepts every origin.
# CORS_ORIGIN=https://app.example.com
# Legacy alias, honoured only when CORS_ORIGIN is unset. Set ONE of the two -
# having both with different values is how the allowlist silently goes wrong.
# FRONTEND_URL=https://app.example.com

# ---------------------------------------------------------------------------
# Payments - Razorpay (optional)
# ---------------------------------------------------------------------------
# Leave blank to run without online checkout; bookings and invoices can then be
# settled by UPI or cash. Both must be set or checkout reports itself
# unconfigured rather than pretending to work.
RAZORPAY_KEY=
RAZORPAY_SECRET=

# UPI id shown on booking confirmations and invoices. Falls back to the
# per-salon upiId from Settings when set there.
UPI_ID=

# ---------------------------------------------------------------------------
# Messaging - WhatsApp Meta Cloud API (optional)
# ---------------------------------------------------------------------------
# Leave blank to run in local mock mode: messages are logged (recipient masked,
# body never logged) and NOT delivered. The server reports which integrations
# are live at startup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ---------------------------------------------------------------------------
# Hardware - eSSL biometric attendance devices (optional)
# ---------------------------------------------------------------------------
# Shared secret sent by the device as the `x-attendance-key` header. When it is
# NOT set, /api/attendance/sync still requires a signed-in owner session; the
# endpoint is never anonymous.
# ATTENDANCE_API_KEY=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# IANA timezone the cron jobs schedule in and dates are derived in.
TZ=Asia/Kolkata
